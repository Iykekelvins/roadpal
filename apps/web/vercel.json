{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "cd ../.. && corepack pnpm install --frozen-lockfile",
  "buildCommand": "cd ../.. && corepack pnpm --filter \"@repo/web...\" run build",
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- . ../../packages/shared ../../pnpm-lock.yaml ../../package.json"
}
