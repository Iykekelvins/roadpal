# Neon pooled connection (hostname contains "-pooler") — used by the running API
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
# Neon direct connection — used by drizzle-kit for migrations
DATABASE_URL_DIRECT=postgresql://user:password@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require
