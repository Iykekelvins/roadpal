# Port the API listens on. 8000 keeps it clear of other Next.js projects, which default to 3000.
PORT=8000

# Neon pooled connection (hostname contains "-pooler") — used by the running API
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=verify-full
# Neon direct connection — used by drizzle-kit for migrations
DATABASE_URL_DIRECT=postgresql://user:password@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=verify-full

# Signs access tokens. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-random-string-of-at-least-32-chars

# Web app origins allowed to open a realtime (Socket.IO) connection, comma-separated.
WEB_ORIGINS=http://localhost:3001

# Most login codes sent per day across the whole app: caps SMS cost (limit x price per SMS).
OTP_DAILY_LIMIT=200

# Proxies in front of the API, so per-IP limits see the real client (production: see deploy notes).
TRUST_PROXY_HOPS=0

# Background sweeps (expiry, radius widening, cleanup). Set to false to pause them locally.
SWEEPS_ENABLED=true

# Integration tests only: a separate Neon branch. Never the dev database (the test setup refuses it).
TEST_DATABASE_URL=postgresql://user:password@ep-yyyy-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=verify-full
