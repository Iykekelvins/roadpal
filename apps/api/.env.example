# Neon pooled connection (hostname contains "-pooler") — used by the running API
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=verify-full
# Neon direct connection — used by drizzle-kit for migrations
DATABASE_URL_DIRECT=postgresql://user:password@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=verify-full

# Signs access tokens. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-random-string-of-at-least-32-chars
